# The claim page is fully static and reads the chain directly — no server, so no place a secret
# could be logged. These are baked in at build time and are all public values.
VITE_NETWORK=sepolia
# Keyless and public on purpose — see below.
VITE_RPC_URL=https://api.cartridge.gg/x/starknet/sepolia
VITE_ESCROW_ADDRESS=0x1ff4c7f216a9e1452e4533e03f926e2b10c7868a085b52c6034bcaa3cf3108

# NEVER put a keyed endpoint here. Vite inlines every VITE_* value into the public bundle, so an
# Alchemy or Infura URL with the key in its path is published the moment the page ships. This file
# held one until it was caught by the bundle check below — the live site was never built from it,
# but a local `vite build` would have baked it in.
#
# `pnpm build` in this app scans its own output and fails on a key-bearing URL, so this cannot
# recur silently.
