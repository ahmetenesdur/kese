node_modules/
.env
.env.local
dist/
target/
*.log
.DS_Store

# Personal notes (Turkish) — never committed
*.tr.md

# Local scratch pending manual deletion
_to_delete/

# Claude Code local settings
.claude/settings.local.json

# Vendored SDK tarball (local unblock until read:packages scope is granted — see docs/decisions.md D-005)
vendor/
smoke-report*.json

# Runtime policy state — spending history, never committed
kese-policy.sqlite*
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Compiled output must never land beside the sources — it shadows them at import time
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/src/**/*.js.map

# Claim page build env (contains the RPC key)
apps/claim/.env

# Assembled by scripts/build-vercel-tree.mjs; regenerate, never edit in place.
apps/claim/.vercel-tree/
