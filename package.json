{
  "name": "kese",
  "private": true,
  "description": "Private money for AI agents on STRK20 — policy-guarded MCP wallet layer",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r build && tsc --noEmit -p tsconfig.scripts.json",
    "smoke": "tsx scripts/day1-sepolia-smoke.ts",
    "smoke:mock": "tsx scripts/day1-sepolia-smoke.ts --mode=mock",
    "smoke:simulate": "tsx scripts/day1-sepolia-smoke.ts --mode=simulate",
    "smoke:sepolia": "tsx scripts/day1-sepolia-smoke.ts --mode=service",
    "test": "node scripts/check-no-shadow.mjs && vitest run",
    "dashboard": "pnpm --filter @kese/dashboard dev",
    "claim": "pnpm --filter @kese/claim-page dev",
    "keys:gen": "tsx scripts/gen-smoke-keys.ts",
    "telegram:dry-run": "tsx scripts/telegram-dry-run.ts",
    "escrow:build": "bash scripts/cairo.sh build",
    "escrow:test": "bash scripts/cairo.sh test",
    "escrow:deploy": "tsx scripts/deploy-escrow.ts",
    "check:shadow": "node scripts/check-no-shadow.mjs"
  },
  "dependencies": {
    "@starkware-libs/starknet-privacy-sdk": "0.14.3-rc.5",
    "starknet": "10.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
