# --- Starknet ---
RPC_URL=https://rpc.starknet.lava.build        # mainnet public RPC (Day-0 guide) or your Alchemy URL
CHAIN_ID=SN_MAIN                                # SN_MAIN | SN_SEPOLIA
ACCOUNT_ADDRESS=                                # server signer account (agent's operational account)
ACCOUNT_PRIVATE_KEY=                            # NEVER commit; NEVER expose to the LLM context
VIEWING_KEY=                                    # bigint DECIMAL string. MUST be bigint at runtime; hex silently misbehaves

# --- STRK20 ---
POOL_ADDRESS=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a   # mainnet pool (Day-0 guide)
# POOL_ADDRESS=0x0254a6b2997ef52e9f830ce1f543f6b29768295e8d17e2267d672c552cfe0d91 # sepolia pool v2.0
PROVING_SERVICE_URL=                            # DAY-1 TASK: request via hackathon repo GitHub issue (mainnet URL not published)
# Discovery: leave INDEXER_URL empty to use ContractDiscoveryProvider (RPC-based, no external dep)
INDEXER_URL=

# --- Kese ---
ESCROW_CONTRACT_ADDRESS=                        # filled after contracts/escrow-claim deploy
POLICY_DB_PATH=./kese-policy.sqlite
TELEGRAM_BOT_TOKEN=                             # @BotFather
TELEGRAM_OWNER_CHAT_ID=
APPROVAL_TIMEOUT_SECONDS=900
