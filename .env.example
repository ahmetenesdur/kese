# --- Network selection ---
KESE_NETWORK=sepolia                            # sepolia | mainnet (PLAN.md: stay on sepolia until Phase M)
                                                # Code must resolve RPC_URL / POOL_ADDRESS / PROVING_SERVICE_URL from this.

# --- Starknet RPC (Alchemy: paste the FULL https URL including your key — one per network) ---
RPC_URL_SEPOLIA=                                # https://starknet-sepolia.g.alchemy.com/starknet/version/rpc/v0_10/<YOUR_KEY>
RPC_URL_MAINNET=                                # https://starknet-mainnet.g.alchemy.com/starknet/version/rpc/v0_10/<YOUR_KEY>
# Public mainnet fallback (Day-0 guide): https://rpc.starknet.lava.build
# If starknet.js complains about the RPC spec version (v0_10), try the fallback URL and note it in docs/decisions.md.

# --- Account (server signer for the agent) ---
ACCOUNT_ADDRESS=
ACCOUNT_PRIVATE_KEY=                            # NEVER commit; NEVER expose to the LLM context
VIEWING_KEY=                                    # bigint DECIMAL string. MUST be bigint at runtime; hex silently misbehaves

# --- STRK20 pool (per network; resolved by KESE_NETWORK) ---
POOL_ADDRESS_MAINNET=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a
POOL_ADDRESS_SEPOLIA=0x0254a6b2997ef52e9f830ce1f543f6b29768295e8d17e2267d672c552cfe0d91
PROVING_SERVICE_URL_SEPOLIA=                    # awaiting reply on strk20-hackathon issue #147
PROVING_SERVICE_URL_MAINNET=                    # awaiting reply on strk20-hackathon issue #147
# Discovery: leave INDEXER_URL empty to use ContractDiscoveryProvider (RPC-based, no external dep)
INDEXER_URL=

# --- Day-1 smoke test (scripts/day1-sepolia-smoke.ts) ---
PROVING_MODE=mock                               # mock | simulate | service  (overridden by --mode=)
                                                #   mock     — in-memory pool; no chain, keys or proving needed
                                                #   simulate — live RPC + real pool, SDK's mock prover, nothing submitted
                                                #   service  — real proofs + real submission (needs PROVING_SERVICE_URL_*)
SMOKE_TOKEN=STRK                                # symbol from TOKENS in packages/core/src/config.ts, or a raw 0x address
SMOKE_AMOUNT=100000000000000000                 # 0.1 STRK (18 decimals). Round numbers resist amount-fingerprinting (notes §8)
SMOKE_RECIPIENT_ADDRESS=                        # a 2nd REGISTERED account; empty ⇒ self-transfer (still exercises the private path)

# --- Kese ---
ESCROW_CONTRACT_ADDRESS=                        # filled after contracts/escrow-claim deploy (per network)
POLICY_DB_PATH=./kese-policy.sqlite
TELEGRAM_BOT_TOKEN=                             # from @BotFather
TELEGRAM_OWNER_CHAT_ID=
APPROVAL_TIMEOUT_SECONDS=900
