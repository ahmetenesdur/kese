# The Privacy SDK is published to GitHub Packages, not npmjs.org. Without this line a clean
# clone resolves @starkware-libs/* against the public registry and fails with a 404 that looks
# like the package does not exist.
#
# The TOKEN is deliberately not here and must never be: authenticate with your own account —
#   gh auth refresh -h github.com -s read:packages
#   npm config set '//npm.pkg.github.com/:_authToken' "$(gh auth token)"
# See README "Install" for the no-GitHub-account fallback (scripts/vendor-sdk.sh).
@starkware-libs:registry=https://npm.pkg.github.com
